<Window x:Class="SmartOffice365.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartOffice365.UI.Views"
        xmlns:vm="clr-namespace:SmartOffice365.UI.ViewModels"
        Title="Smart Office 365 — Cockpit Shutdown"
        Height="850" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">


    <Window.Resources>
        <!-- =================================================================== -->
        <!-- CORRESPONDANCE DES PINCEAUX ET POLICES AVEC GEMINITHEME             -->
        <!-- =================================================================== -->
        <SolidColorBrush x:Key="GeminiBgBrush" Color="#0D1117"/>
        <!-- PrimaryBackground -->
        <SolidColorBrush x:Key="GeminiSidebarBgBrush" Color="#161B22"/>
        <!-- SecondaryBackground -->
        <SolidColorBrush x:Key="GeminiTopBarBgBrush" Color="#161B22"/>
        <!-- SecondaryBackground -->
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#30363D"/>
        <!-- BorderColor -->
        <SolidColorBrush x:Key="GeminiCardBgBrush" Color="#2D333B"/>
        <!-- CardBackground -->
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#3FB950"/>
        <!-- SuccessColor -->
        <FontFamily x:Key="GeminiFontFamily">Segoe UI</FontFamily>

        <!-- Dégradé de couleur pour le logo Gemini -->
        <LinearGradientBrush x:Key="GeminiGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#58A6FF" Offset="0.0"/>
            <GradientStop Color="#AB70FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Styles de texte et contrôles de la TopBar -->
        <Style x:Key="GeminiSeparator" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderColor}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="GeminiHeaderTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        </Style>

        <Style x:Key="GeminiSubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}"/>
        </Style>

        <Style x:Key="GeminiInputBar" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

        <!-- =================================================================== -->
        <!-- STYLE DES BOUTONS DE NAVIGATION DE LA SIDEBAR                       -->
        <!-- =================================================================== -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- AJOUTÉ : Début de la valeur du Setter -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Icône (Segoe MDL2 Assets) passée dans la propriété Tag -->
                                <TextBlock Text="{TemplateBinding Tag}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="18" 
                                           HorizontalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <!-- Libellé sous l'icône -->
                                <TextBlock Text="{TemplateBinding Content}" 
                                           FontSize="9" 
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" 
                                           Margin="0,4,0,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SurfaceBackground}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource TertiaryBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
                <!-- AJOUTÉ : Fin de la valeur du Setter -->
            </Setter>
        </Style>


        <!-- =================================================================== -->
        <!-- DATATEMPLATES POUR LA NAVIGATION DYNAMIQUE MVVM                     -->
        <!-- =================================================================== -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <!-- AJOUTÉ : DataTemplate pour la Gestion des Arrêts -->
        <DataTemplate DataType="{x:Type vm:ArretsViewModel}">
            <views:ArretsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdresDeTravailViewModel}">
            <views:OrdresDeTravailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrerequisViewModel}">
            <views:PrerequisView />
            <!-- CORRIGÉ : Retrait de l'accent sur le 'i' -->
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RessourcesViewModel}">
            <views:RessourcesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContactsViewModel}">
            <views:ContactsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
            <views:ConfigurationView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar colonne (72px fixe) -->
            <ColumnDefinition Width="Auto" />
            <!-- Zone principale -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =================================================================== -->
        <!-- 1. SIDEBAR RÉTRACTABLE (STYLE GEMINI / FLUID DESIGN)               -->
        <!-- =================================================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource GeminiSidebarBgBrush}"
                BorderBrush="{StaticResource AccentBorderBrush}"
                BorderThickness="0,0,1,0"
                Width="72">
            <DockPanel LastChildFill="False">

                <!-- Logo / Icone App en haut -->
                <Border DockPanel.Dock="Top" Margin="0,16,0,24" HorizontalAlignment="Center">
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="12" Background="{StaticResource GeminiGradientBrush}" />
                        <TextBlock Text="✦"
                                   FontFamily="{StaticResource GeminiFontFamily}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#131314"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Navigation Principale -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE80F;" Content="Cockpit"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />

                    <!-- AJOUTÉ : Bouton Gestion des Arrêts -->
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE787;" Content="Arrêts"
                            Command="{Binding NavigateCommand}" CommandParameter="Arrets" />

                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE825;" Content="OT &amp; SAP"
                            Command="{Binding NavigateCommand}" CommandParameter="OrdresDeTravail" />
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE73E;" Content="Prérequis"
                            Command="{Binding NavigateCommand}" CommandParameter="Prerequis" />
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE707;" Content="Ressources"
                            Command="{Binding NavigateCommand}" CommandParameter="Ressources" />
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE77B;" Content="Contacts"
                            Command="{Binding NavigateCommand}" CommandParameter="Contacts" />
                </StackPanel>

                <!-- Bouton Configuration en bas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <Separator Style="{StaticResource GeminiSeparator}" Margin="8,0,8,12" />
                    <Button Style="{StaticResource SidebarNavButton}"
                            Tag="&#xE713;" Content="Config"
                            Command="{Binding NavigateCommand}" CommandParameter="Configuration" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- =================================================================== -->
        <!-- 2. ZONE DE TRAVAIL PRINCIPALE                                       -->
        <!-- =================================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- TopBar Search -->
                <RowDefinition Height="*" />
                <!-- Contenu central -->
                <RowDefinition Height="Auto" />
                <!-- StatusBar -->
            </Grid.RowDefinitions>

            <!-- TOPBAR FLOTTANTE -->
            <Border Grid.Row="0"
                    Background="{StaticResource GeminiTopBarBgBrush}"
                    Padding="24,16"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Titre de la section -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle}"
                                   Style="{StaticResource GeminiHeaderTitle}"
                                   FontSize="20" Margin="0" />
                        <TextBlock Text="Smart Office 365 — Centralisation SAP PM &amp; O365"
                                   Style="{StaticResource GeminiSubTitle}" FontSize="11" />
                    </StackPanel>

                    <!-- Barre de recherche globale flottante Gemini -->
                    <Border Grid.Column="1" Width="400" Margin="16,0">
                        <TextBox Style="{StaticResource GeminiInputBar}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Rechercher par N° OT SAP, Équipement, Contact..." />
                    </Border>

                    <!-- Profile / Statut Microsoft 365 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource GeminiCardBgBrush}"
                                CornerRadius="20" Padding="12,6"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontFamily="{StaticResource GeminiFontFamily}"
                                           FontSize="12" 
                                           Foreground="{StaticResource PrimaryText}" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>


                </Grid>
            </Border>

            <!-- ZONE DE CONTENU DYNAMIQUE -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="16" />
            <!-- BARRE D'ÉTAT (STATUSBAR GEMINI - 28px strictly) -->
            <StatusBar Grid.Row="2" Height="28" Background="#1A2F4A" Foreground="White" Padding="12,0">
                <StatusBarItem VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <!-- Affichage dynamique du nom d'utilisateur connecté -->
                        <TextBlock Text="Graph API: Connecté (" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserDisplayName}" FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#58A6FF" VerticalAlignment="Center"/>
                        <TextBlock Text=")" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>

                        <TextBlock Text="  |  " FontSize="11" Foreground="#444746" VerticalAlignment="Center"/>
                        <!-- Affichage dynamique du statut -->
                        <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusMessage, Converter={StaticResource StatusToColorConverter}}"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           TextTrimming="CharacterEllipsis"
                           Width="300"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>


        </Grid>
    </Grid>
</Window>
