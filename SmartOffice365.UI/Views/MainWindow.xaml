<Window x:Class="SmartOffice365.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartOffice365.UI.Views"
        xmlns:converters="clr-namespace:SmartOffice365.UI.Converters"
        Title="Smart Office 365" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Barre de titre/entête -->
            <RowDefinition Height="*"/>        <!-- Contenu principal -->
            <RowDefinition Height="Auto"/>    <!-- Barre d'état -->
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- BARRE D'ENTÊTE / TITRE                     -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                Background="{StaticResource DarkBackgroundBrush}" 
                BorderBrush="{StaticResource DarkBorderBrush}" 
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Titre -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏢" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Smart Office 365" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Info utilisateur -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserName}" 
                               Foreground="{StaticResource TextBrush}" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                    <Ellipse Width="10" Height="10" 
                             Fill="{Binding IsConnected, Converter={StaticResource ConnectionStatusBrush}}"
                             VerticalAlignment="Center" 
                             Margin="0,0,10,0"/>
                    <Button Content="Déconnexion" 
                            Command="{Binding LogoutCommand}" 
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- CONTENU PRINCIPAL                          -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="10">
            <!-- Vue de sélection de site (visible uniquement si aucun site sélectionné) -->
            <views:SiteSelectionView x:Name="SiteSelectionControl" 
                                      Visibility="{Binding HasActiveSite, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- Vue principale (visible si un site est sélectionné) -->
            <TabControl Visibility="{Binding HasActiveSite, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem Header="📊 Dashboard" Style="{StaticResource TabItemStyle}">
                    <views:DashboardView/>
                </TabItem>
                <TabItem Header="📋 Ordres de Travail" Style="{StaticResource TabItemStyle}">
                    <views:OrdresDeTravailView/>
                </TabItem>
                <TabItem Header="👤 Contacts" Style="{StaticResource TabItemStyle}">
                    <views:ContactsView/>
                </TabItem>
                <TabItem Header="📦 Ressources" Style="{StaticResource TabItemStyle}">
                    <views:RessourcesView/>
                </TabItem>
                <TabItem Header="🔧 Configuration" Style="{StaticResource TabItemStyle}">
                    <views:ConfigurationView/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ========================================== -->
        <!-- BARRE D'ÉTAT                                -->
        <!-- ========================================== -->
        <StatusBar Grid.Row="2" 
                   Background="{StaticResource StatusBarBackgroundBrush}"
                   BorderBrush="{StaticResource DarkBorderBrush}"
                   BorderThickness="0,1,0,0"
                   Height="30">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- 1. Statut de connexion -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" 
                             Fill="{Binding IsConnected, Converter={StaticResource ConnectionStatusBrush}}"
                             VerticalAlignment="Center" 
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" 
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 2. Site SharePoint actif -->
            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" FontSize="12" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ActiveSiteName}" 
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               Visibility="{Binding HasActiveSite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Aucun site sélectionné" 
                               Foreground="{StaticResource DisabledTextBrush}"
                               FontSize="12"
                               FontStyle="Italic"
                               Visibility="{Binding HasActiveSite, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 3. KPIs rapides -->
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊 Total OT: " Foreground="{StaticResource TextBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding TotalOT}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    
                    <TextBlock Text="✅ " Foreground="LightGreen" FontSize="11"/>
                    <TextBlock Text="{Binding TotalOTTermines}" Foreground="LightGreen" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    
                    <TextBlock Text="🔴 " Foreground="OrangeRed" FontSize="11"/>
                    <TextBlock Text="{Binding TotalOTBloques}" Foreground="OrangeRed" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    
                    <TextBlock Text="⚠️ " Foreground="Orange" FontSize="11"/>
                    <TextBlock Text="{Binding TotalOTEnRetard}" Foreground="Orange" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </StatusBarItem>

            <!-- 4. Message de statut -->
            <StatusBarItem Grid.Column="3">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="{Binding StatusMessage, Converter={StaticResource StatusToColorConverter}}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>

            <!-- 5. Horloge / Version -->
            <StatusBarItem Grid.Column="4" HorizontalContentAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentTime}" 
                               Foreground="{StaticResource DisabledTextBrush}"
                               FontSize="11"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="v1.0.0" 
                               Foreground="{StaticResource DisabledTextBrush}"
                               FontSize="10"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>