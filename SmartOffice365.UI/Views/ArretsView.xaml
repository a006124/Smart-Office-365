<UserControl x:Class="SmartOffice365.UI.Views.ArretsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartOffice365.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Convertisseur de visibilité natif -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Style pour les badges de statut dynamiques -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statut}" Value="En préparation">
                    <Setter Property="Background" Value="#1F2C1F"/>
                    <Setter Property="BorderBrush" Value="#2EA043"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="En cours">
                    <Setter Property="Background" Value="#372E15"/>
                    <Setter Property="BorderBrush" Value="#D29922"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Terminé">
                    <Setter Property="Background" Value="#152438"/>
                    <Setter Property="BorderBrush" Value="#388BFD"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Annulé">
                    <Setter Property="Background" Value="#341D1D"/>
                    <Setter Property="BorderBrush" Value="#F85149"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style pour le texte à l'intérieur des badges -->
        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Statut}" Value="En préparation">
                    <Setter Property="Foreground" Value="#56D364"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="En cours">
                    <Setter Property="Foreground" Value="#F1E05A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Terminé">
                    <Setter Property="Foreground" Value="#79C0FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Statut}" Value="Annulé">
                    <Setter Property="Foreground" Value="#FF7B72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <!-- Colonne Gauche : Liste des arrêts (60% de l'espace) -->
            <ColumnDefinition Width="1.2*" />
            <!-- Séparateur visuel -->
            <ColumnDefinition Width="24" />
            <!-- Colonne Droite : Formulaire d'édition / Détails (40% de l'espace) -->
            <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <!-- =================================================================== -->
        <!-- COLONNE GAUCHE : LISTE DES ARRÊTS                                   -->
        <!-- =================================================================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Barre d'outils -->
                <RowDefinition Height="*"/>
                <!-- Liste des cartes -->
            </Grid.RowDefinitions>

            <!-- Barre d'outils (Recherche & Bouton Ajouter) -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titre de section local -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Périodes d'Arrêts Planifiées" Foreground="#F0F6FC" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Sélectionnez un arrêt pour le modifier ou afficher ses jalons." Foreground="#8B949E" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bouton Planifier un nouvel arrêt -->
                <Button Grid.Column="1" 
                        Command="{Binding NouvelArretCommand}" 
                        Background="#238636" Foreground="White" FontWeight="SemiBold" FontSize="13"
                        Padding="16,10" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Planifier un Arrêt" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Liste des cartes d'arrêts -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding Arrets}"
                         SelectedItem="{Binding SelectedArret}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0,0,0,12"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Carte d'arrêt -->
                            <Border x:Name="CardBorder" 
                                    Background="#161B22" 
                                    BorderBrush="#30363D" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="18"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Ligne 1 : Titre & Badge Statut -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Titre}" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}">
                                            <TextBlock Text="{Binding Statut}" Style="{StaticResource StatusBadgeText}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Ligne 2 : Dates de début et de fin -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#8B949E" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Du " Foreground="#8B949E" FontSize="13"/>
                                        <TextBlock Text="{Binding DateDebut, StringFormat='dd MMMM yyyy à HH:mm'}" Foreground="#C9D1D9" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text=" au " Foreground="#8B949E" FontSize="13"/>
                                        <TextBlock Text="{Binding DateFin, StringFormat='dd MMMM yyyy à HH:mm'}" Foreground="#C9D1D9" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- Ligne 3 : Jalons de préparation -->
                                    <Border Grid.Row="2" Background="#0D1117" CornerRadius="6" Padding="10,8" BorderBrush="#21262D" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Jalons : " Foreground="#58A6FF" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding JalonsPreparation}" Foreground="#C9D1D9" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Triggers visuels pour le survol et la sélection de la carte -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#58A6FF"/>
                                    <Setter TargetName="CardBorder" Property="Background" Value="#21262D"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#8B949E"/>
                                    <Setter TargetName="CardBorder" Property="Background" Value="#1C2128"/>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <!-- =================================================================== -->
        <!-- COLONNE DROITE : FORMULAIRE D'ÉDITION / CRÉATION                    -->
        <!-- =================================================================== -->
        <Grid Grid.Column="2">

            <!-- ÉCRAN 1 : Formulaire actif (Visible si IsEditMode = True) -->
            <Border Background="#161B22" 
                    BorderBrush="#30363D" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="24"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- En-tête -->
                        <RowDefinition Height="*"/>
                        <!-- Formulaire défilant -->
                        <RowDefinition Height="Auto"/>
                        <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- En-tête du formulaire -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configuration de l'Arrêt" Foreground="#F0F6FC" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Renseignez les informations de planification" Foreground="#8B949E" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <!-- Bouton Supprimer rapide -->
                        <Button Grid.Column="1" Command="{Binding SupprimerCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Supprimer cet arrêt">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#F85149" FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- Formulaire de saisie -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Titre -->
                            <TextBlock Text="Nom de l'arrêt" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditingArret.Titre, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="10" Margin="0,0,0,16" CaretBrush="White">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Dates de début et de fin -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date de début" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding EditingArret.DateDebut}" Height="38" Background="#0D1117" BorderBrush="#30363D"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Date de fin" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <DatePicker SelectedDate="{Binding EditingArret.DateFin}" Height="38" Background="#0D1117" BorderBrush="#30363D"/>
                                </StackPanel>
                            </Grid>

                            <!-- Statut -->
                            <TextBlock Text="Statut de l'arrêt" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding EditingArret.Statut}" SelectedValuePath="Content" Background="#0D1117" BorderBrush="#30363D" Margin="0,0,0,16" Padding="10" Height="40">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="En préparation"/>
                                <ComboBoxItem Content="En cours"/>
                                <ComboBoxItem Content="Terminé"/>
                                <ComboBoxItem Content="Annulé"/>
                            </ComboBox>

                            <!-- Jalons de préparation -->
                            <TextBlock Text="Jalons de préparation" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditingArret.JalonsPreparation, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="10" Margin="0,0,0,16" CaretBrush="White">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Description -->
                            <TextBlock Text="Description &amp; Objectifs" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding EditingArret.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1" Padding="10" Height="120" 
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" CaretBrush="White">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions du formulaire (Enregistrer / Annuler) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding AnnulerCommand}" 
                                Content="Annuler" Background="Transparent" Foreground="#8B949E" 
                                BorderBrush="#30363D" BorderThickness="1" Padding="12,10" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Command="{Binding EnregistrerCommand}" 
                                Content="Enregistrer" Background="#238636" Foreground="White" FontWeight="SemiBold"
                                BorderThickness="0" Padding="12,10" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ÉCRAN 2 : Placeholder (Visible uniquement si IsEditMode = False) -->
            <Border Background="#161B22" 
                    BorderBrush="#30363D" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="40"
                    VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Icône Gemini stylisée -->
                    <Grid Width="64" Height="64" Margin="0,0,0,20" HorizontalAlignment="Center">
                        <Border CornerRadius="20" Background="{DynamicResource GeminiGradientBrush}" Opacity="0.15" />
                        <TextBlock Text="✦" FontFamily="Segoe UI" FontSize="32" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Aucun arrêt sélectionné" Foreground="#F0F6FC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Sélectionnez un arrêt dans la liste de gauche pour afficher ses détails, ou cliquez sur 'Planifier un Arrêt' pour en créer un nouveau." 
                               Foreground="#8B949E" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
